// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// PARA GERAR UMA MIGRATION -> npx prisma migrate dev 

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model user {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  name         String?
  display_name String?
  password     String?
  banned       Boolean
}

model message {
  id         Int      @id @default(autoincrement())
  message    String
  user_id    Int
  channel_id Int
  date       DateTime
  deleted    Boolean
}

model friendship { // DELETAVEL
  id       Int      @id @default(autoincrement())
  user_id1 Int
  user_id2 Int
  date     DateTime
}

model friend_requests { // DELETAVEL
  id       Int      @id @default(autoincrement())
  user_id1 Int
  user_id2 Int
  date     DateTime
}

model blocked_users { // DELETAVEL
  id       Int      @id @default(autoincrement())
  user_id1 Int
  user_id2 Int
  date     DateTime
}

model channel {
  id      Int     @id @default(autoincrement())
  name    String
  deleted Boolean
}

model user_channel_relation { // DELETAVEL
  id         Int @id @default(autoincrement())
  user_id   Int
  channel_id Int
}
