// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// PARA GERAR UMA MIGRATION -> npx prisma migrate dev 

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model user {
  id           Int     @id @default(autoincrement())
  email        String  @unique
  name         String?
  display_name String?
  password     String?
  banned       Boolean
}

